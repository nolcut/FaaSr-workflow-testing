    "nop-2": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "nop_2",
      "Arguments": {
        "folder": "workflow_data"
      },
      "InvokeNext": [
        "nop-3"
      ]
    },
    "nop-3": {
