{
  "FunctionInvoke": "generate-words",
  "WorkflowName": "wordcount-mapreduce-histogram-1115-0103",
  "DefaultDataStore": "S3",
  "LoggingDataStore": "S3",
  "FaaSrLog": "FaaSrLog",
  "InvocationIDFromDate": "%Y-%m-%d-%H-%M-%S",
  "ActionList": {
    "generate-words": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "generate_words",
      "Arguments": {
        "folder": "wordcount_mapreduce-1115-0103",
        "output1": "corpus.txt"
      },
      "InvokeNext": [
        "map-word-counts(4)"
      ]
    },
    "map-word-counts": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "map_word_counts",
      "Arguments": {
        "folder": "wordcount_mapreduce-1115-0103",
        "input1": "corpus.txt",
        "output1": "partial_counts_{rank}.json"
      },
      "InvokeNext": [
        "reduce-word-counts"
      ]
    },
    "reduce-word-counts": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "reduce_word_counts",
      "Arguments": {
        "folder": "wordcount_mapreduce-1115-0103",
        "input1": "partial_counts_{rank}.json",
        "output1": "word_frequencies.csv"
      },
      "InvokeNext": [
        "visualize-histogram"
      ]
    },
    "visualize-histogram": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "visualize_histogram",
      "Arguments": {
        "folder": "wordcount_mapreduce-1115-0103",
        "input1": "word_frequencies.csv",
        "output1": "word_frequency_histogram.png"
      },
      "InvokeNext": []
    }
  },
  "ActionContainers": {
    "generate-words": "ghcr.io/faasr/github-actions-python:latest",
    "map-word-counts": "ghcr.io/faasr/github-actions-python:latest",
    "reduce-word-counts": "ghcr.io/faasr/github-actions-python:latest",
    "visualize-histogram": "ghcr.io/faasr/github-actions-python:latest"
  },
  "ComputeServers": {
    "GH": {
      "FaaSType": "GitHubActions",
      "UserName": "nolcut",
      "ActionRepoName": "FaaSr-workflow-testing",
      "Branch": "main",
      "UseSecretStore": true
    }
  },
  "DataStores": {
    "S3": {
      "Endpoint": "https://s3.us-east-1.amazonaws.com",
      "Bucket": "faasr-agent-new",
      "Region": "us-east-1",
      "AccessKey": "S3_AccessKey",
      "SecretKey": "S3_SecretKey",
      "Writable": "TRUE"
    }
  },
  "FunctionGitRepo": {
    "generate_words": "nolcut/FaaSr-workflow-testing/main/functions/wordcount-mapreduce-histogram-1115-0103/generate_words.py",
    "map_word_counts": "nolcut/FaaSr-workflow-testing/main/functions/wordcount-mapreduce-histogram-1115-0103/map_word_counts.py",
    "reduce_word_counts": "nolcut/FaaSr-workflow-testing/main/functions/wordcount-mapreduce-histogram-1115-0103/reduce_word_counts.py",
    "visualize_histogram": "nolcut/FaaSr-workflow-testing/main/functions/wordcount-mapreduce-histogram-1115-0103/visualize_histogram.py"
  },
  "PyPIPackageDownloads": {
    "visualize_histogram": [
      "matplotlib"
    ]
  }
}